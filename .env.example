NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=
SESSION_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql://eduroll:local-only-change-me@localhost:5432/eduroll
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true

# Groq free-tier inference. Create a key at https://console.groq.com/keys.
# Server-side only; never expose this key in browser code.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Required for email verification and password reset in production
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=eduRoll <no-reply@example.com>

# Operational controls
SESSION_MAX_AGE_DAYS=14
SEARCH_RATE_LIMIT_PER_MINUTE=8
BRANCH_RATE_LIMIT_PER_MINUTE=15
USER_DAILY_GENERATION_LIMIT=40
MAX_LEARNING_DEPTH=10
